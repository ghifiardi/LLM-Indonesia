__pycache__/
*.pyc

# Office lock files
~$*

# Tantular model weights / adapters / generated data (built locally)
tantular/adapters/
tantular/weights/
tantular/data/
*.gguf

# Fine-tune spike: venv + downloaded/exported artifacts (built locally)
tantular/finetune/.venv/
tantular/finetune/spike/tinker_adapter_raw/
tantular/finetune/spike/peft_adapter/
tantular/finetune/spike/Modelfile.spike
tantular/finetune/.pytest_cache/
tantular/finetune/**/__pycache__/

# Android build outputs / machine-specific config
android/**/build/
android/**/.gradle/
android/**/.gradle-user-home/
android/**/local.properties
android/**/.idea/
android/**/*.apk

# Vendored on-device runtime (fetched by scripts/fetch_llama_cpp.sh) + native output
android/**/app/src/main/cpp/llama.cpp/
android/**/.cxx/
android/**/app/src/main/jniLibs/
.DS_Store

# Office add-in local artifacts
tantular_office_addin/certs/
tantular_office_addin/*.mp4
tantular_office_addin/.venv-doc/

# Resident loop runtime state (sqlite metadata, artifacts, champion pointer).
# Source, tests, and schema definitions under resident/ stay tracked.
.resident/
resident/.resident/
