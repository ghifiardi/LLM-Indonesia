data/
certs/

# Vercel project link (projectId/orgId), created by `vercel deploy` inside
# dist/workshop-web. The rule lives HERE, not in dist/workshop-web/.gitignore,
# because build-workshop-web.mjs starts with rmSync(out, {recursive:true}) —
# an ignore file inside the build output is deleted by the next build, and
# .vercel silently becomes committable again.
.vercel/

# Release artifacts: the zips and one-line installers that build-workshop-
# package.mjs writes for the download page. Regenerated by every build and
# binary, so they are published by `vercel deploy`, not committed.
#
# The rule lives HERE for the same reason the .vercel one does: an ignore file
# inside dist/workshop-web/ is deleted by the next build (it wipes everything
# except .vercel), and the entry silently stops applying.
dist/workshop-web/downloads/

# Installed dependencies. package-lock.json IS committed (see below), so a
# checkout reproduces this directory with `npm ci` — committing the tree itself
# would add thousands of files to every dependency bump.
node_modules/
