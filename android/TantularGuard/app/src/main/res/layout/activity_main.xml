<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/navy"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/home_tagline"
                android:textColor="#CBD5E1"
                android:textSize="14sp" />

            <Button
                android:id="@+id/howToUseButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_secondary"
                android:minHeight="40dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/how_to_use_button"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Primary: check a message -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="18dp">

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:background="@drawable/input_background"
                android:gravity="top|start"
                android:hint="@string/input_hint"
                android:inputType="textMultiLine"
                android:minLines="5"
                android:padding="14dp"
                android:textColor="@color/ink"
                android:textColorHint="#94A3B8"
                android:textSize="16sp" />

            <Button
                android:id="@+id/pasteCheckButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/button_primary"
                android:minHeight="54dp"
                android:text="@string/paste_and_check"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/checkButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:background="@drawable/button_secondary"
                    android:minHeight="50dp"
                    android:text="@string/check_message"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/clearButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_secondary"
                    android:minHeight="50dp"
                    android:text="@string/clear"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/examples_title"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/exampleOtpButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/button_secondary"
                android:minHeight="44dp"
                android:text="@string/example_otp_label"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <Button
                android:id="@+id/examplePrizeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/button_secondary"
                android:minHeight="44dp"
                android:text="@string/example_prize_label"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <Button
                android:id="@+id/exampleNormalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/button_secondary"
                android:minHeight="44dp"
                android:text="@string/example_normal_label"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Result (appears right under the input) -->
        <LinearLayout
            android:id="@+id/resultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <View
                android:id="@+id/resultStrip"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginBottom="12dp"
                android:background="@color/red" />

            <TextView
                android:id="@+id/verdictBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/red"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/verdictMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/signalsView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/slmStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:textStyle="italic" />
        </LinearLayout>

        <!-- Misi Keamanan (gamification) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/game_title"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gameLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/gameProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="100" />

            <TextView
                android:id="@+id/gameStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/missionFirst"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/missionFive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/missionSms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/missionNotif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/ink"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Protections -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/section_protection"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/infoProtection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="ℹ️"
                    android:textSize="18sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/smsToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:minHeight="48dp"
                android:text="@string/sms_guard_toggle"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/smsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sms_guard_off"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="8dp"
                android:background="#E2E8F0" />

            <Switch
                android:id="@+id/notifGuardToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/notif_guard_toggle"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/notifGuardStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notif_guard_off"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/notificationAccessButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_secondary"
                android:minHeight="48dp"
                android:text="@string/notif_access_button"
                android:textAllCaps="false"
                android:textColor="@color/ink" />
        </LinearLayout>

        <!-- Quick account tools -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/section_account"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/infoAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="ℹ️"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ato_help"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/recoveryGuideButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_secondary"
                android:minHeight="48dp"
                android:text="@string/recovery_guide_button"
                android:textAllCaps="false"
                android:textColor="@color/ink" />

            <Button
                android:id="@+id/deviceRiskButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_secondary"
                android:minHeight="48dp"
                android:text="@string/device_risk_button"
                android:textAllCaps="false"
                android:textColor="@color/ink" />
        </LinearLayout>

        <!-- History -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/guard_log_title_short"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/infoHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="ℹ️"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/guardLogStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/guard_log_empty"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/viewGuardLogButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_primary"
                android:minHeight="50dp"
                android:text="@string/view_guard_log_button"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/clearGuardLogButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_secondary"
                android:minHeight="48dp"
                android:text="@string/clear_guard_log_button"
                android:textAllCaps="false"
                android:textColor="@color/ink" />
        </LinearLayout>

        <!-- Advanced toggle -->
        <Button
            android:id="@+id/advancedToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/button_secondary"
            android:minHeight="50dp"
            android:text="@string/advanced_show"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textStyle="bold" />

        <!-- Advanced container (hidden by default) -->
        <LinearLayout
            android:id="@+id/advancedContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- AI on device -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/section_ai"
                        android:textColor="@color/ink"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/infoAi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="ℹ️"
                        android:textSize="18sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/slmToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:text="@string/slm_toggle"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/slm_help"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <RadioGroup
                    android:id="@+id/slmBackendGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioOnDevice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:minHeight="44dp"
                        android:text="@string/slm_backend_ondevice"
                        android:textColor="@color/ink"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/radioDevServer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:text="@string/slm_backend_dev_server"
                        android:textColor="@color/ink"
                        android:textSize="14sp" />
                </RadioGroup>

                <TextView
                    android:id="@+id/slmOnDeviceStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/slm_ondevice_missing_short"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/slmEndpoint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/input_background"
                    android:hint="@string/slm_endpoint_hint"
                    android:inputType="textUri"
                    android:padding="12dp"
                    android:textColor="@color/ink"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/diagnosticsButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/button_secondary"
                    android:minHeight="48dp"
                    android:text="@string/open_diag_button"
                    android:textAllCaps="false"
                    android:textColor="@color/ink" />
            </LinearLayout>

            <!-- WhatsApp how-to -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/wa_howto_title"
                        android:textColor="@color/ink"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/infoWa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="ℹ️"
                        android:textSize="18sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/wa_howto_help"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/wa_howto_steps"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/openWhatsappButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/button_secondary"
                        android:minHeight="48dp"
                        android:text="@string/open_whatsapp_button"
                        android:textAllCaps="false"
                        android:textColor="@color/ink" />

                    <Button
                        android:id="@+id/openWaBusinessButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/button_secondary"
                        android:minHeight="48dp"
                        android:text="@string/open_wa_business_button"
                        android:textAllCaps="false"
                        android:textColor="@color/ink" />
                </LinearLayout>
            </LinearLayout>

            <!-- SMS quarantine (experimental) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/stage2b_title"
                        android:textColor="@color/ink"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/infoQuarantine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="ℹ️"
                        android:textSize="18sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/stage2b_help"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/defaultSmsButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/button_secondary"
                    android:minHeight="48dp"
                    android:text="@string/default_sms_button"
                    android:textAllCaps="false"
                    android:textColor="@color/ink" />

                <TextView
                    android:id="@+id/defaultSmsStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/default_sms_not_ready"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/quarantineStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/quarantine_empty"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/latestQuarantineButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/button_secondary"
                        android:minHeight="48dp"
                        android:text="@string/latest_quarantine_button"
                        android:textAllCaps="false"
                        android:textColor="@color/ink" />

                    <Button
                        android:id="@+id/clearQuarantineButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/button_secondary"
                        android:minHeight="48dp"
                        android:text="@string/clear_quarantine_button"
                        android:textAllCaps="false"
                        android:textColor="@color/ink" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/privacy_note"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
